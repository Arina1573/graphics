#version 460

layout(local_size_x = 32, local_size_y = 32) in;
layout(binding = 0, rgba8) uniform image2D resultImage;

layout(push_constant) uniform PushConstants
{
    vec4 resolutionTime;
    vec4 mouse;
} pc;

float getTime()
{
    return pc.resolutionTime.z;
}

vec2 getResolution()
{
    return pc.resolutionTime.xy;
}

vec4 getMouse()
{
    return vec4(pc.mouse.xy, 0.0, 0.0);
}


mat3 rotateX(float theta){
    float c = cos(theta);
    float s = sin(theta);
    return mat3(
        vec3(1, 0, 0),
        vec3(0, c, s),
        vec3(0, -s, c)
    );
}

mat3 rotateY(float theta){
    float c = cos(theta);
    float s = sin(theta);
    return mat3(
        vec3(c, 0, s),
        vec3(0, 1, 0),
        vec3(-s, 0, c)
    );
}

float length1 ( in vec2 p )
{
    return max ( abs ( p.x ), abs ( p.y ) );
}


float sdTorus( vec3 p, vec2 t )
{
  vec2 q = vec2(length(p.xz)-t.x,p.y);
  return length1(q)-t.y;
}


float sdf ( in vec3 pos, in mat3 m)
{
    vec3 p = m * pos;
    
    float r = length(p);
    p *= 1.0 + 0.05 * sin(r * 5.0 - getTime() * 2.0);
    
    vec3 p1 = rotateX(getTime() * 0.1) * p;
    float r1 = sdTorus(p1, vec2(2.5, 0.15));
    
    vec3 p2 = rotateX(-getTime() * 0.5) * p;
    float r2 = sdTorus(p2, vec2(2.0, 0.15));
    
    vec3 p3 = rotateX(getTime() * 0.9) * p;
    float r3 = sdTorus(p3, vec2(1.5, 0.15));
    
    return min(min(r1, r2), r3);
}

#define MAX_ITERS   90
vec3 trace ( vec3 from, vec3 dir, out bool hit, mat3 m)
{
    vec3     p = from;
    float    totalDist = 0.0;
    
    hit = false;
    
    for (int steps = 0; steps < MAX_ITERS; steps++ )
    {
        float dist = sdf ( p, m)/2.0;
        
        if ( dist < 0.001 )
        {
            hit = true;
            break;
        }
        
        totalDist += dist;
            
        p += dist * dir;
    }
    
    return p;
}

vec3 generateNormal ( vec3 z, float d, mat3 m )
{
    float e   = d;
    float dx1 = sdf(z + vec3(e, 0, 0), m);
    float dx2 = sdf(z - vec3(e, 0, 0), m);
    float dy1 = sdf(z + vec3(0, e, 0), m);
    float dy2 = sdf(z - vec3(0, e, 0), m);
    float dz1 = sdf(z + vec3(0, 0, e), m);
    float dz2 = sdf(z - vec3(0, 0, e), m);
    
    return normalize ( vec3 ( dx1 - dx2, dy1 - dy2, dz1 - dz2 ) );
}
void mainImage (out vec4 fragColor, in vec2 fragCoord)
{
    bool hit;
    vec3 eye   = vec3(0.0, 0.0, 3.0);
    vec3 mouse = vec3(getMouse().xy/getResolution() - 0.5, getMouse().z-.5);
    mat3 m     = rotateX(6.0*mouse.y)* rotateY(6.0*mouse.x);
    vec2 uv    = 6.0*(fragCoord - 0.5 * getResolution()) / getResolution().y;
    vec3 dir   = normalize ( vec3(uv, 0) - eye );
    vec3 light = vec3 ( 5.0, 5.0, 5.0 );
    vec3 p     = trace ( eye, dir, hit, m);
    vec3 color = vec3(0.0);
    
    if ( hit )
    {
        vec3 l = normalize (light - p);
        vec3 v = normalize (eye - p);
        vec3 n = generateNormal (p, 0.001, m);
        float nl = max(0.0, dot (n, l));
        vec3 h = normalize (l+v);
        float hn = max(0.0, dot(h, n));
        float sp = pow(hn, 150.0);
        color = 0.6*vec3 ( nl )+0.7*vec3(sp);
    }

    fragColor = vec4(color, 1.0);
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);

    vec2 resolution = getResolution();
    if (pixel.x >= int(resolution.x) || pixel.y >= int(resolution.y))
        return;

    vec2 fragCoord = vec2(
        float(pixel.x) + 0.5,
        resolution.y - float(pixel.y) - 0.5
    );

    vec4 color;
    mainImage(color, fragCoord);

    imageStore(resultImage, pixel, color);
}
